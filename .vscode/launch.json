{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "LMSBackend.API (Debug)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/LMSBackend.API/bin/Debug/net10.0/LMSBackend.API.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/LMSBackend.API",
            "envFile": "${workspaceFolder}/.env",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5000"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}